# Agentic_VOP API — environment configuration

# --- Environment identity (dev/prod data-isolation guard) ---
# APP_ENV names the environment this process runs in:
#   dev  — local development (DEFAULT). Must point at the DEV Supabase project.
#   prod — the deployed EC2 app (set in SSM: /sisyfix/prod/app/APP_ENV=prod).
#
# When APP_ENV is "dev" (or unset) the app REFUSES TO START if
# AGENTIC_VOP_SUPABASE_URL points at the PROD Supabase project — this is the
# guard that stops local work from ever touching PROD data. For local dev,
# leave this as "dev" and set the Supabase values below to your DEV project.
APP_ENV=dev

# --- Supabase project (where we WRITE: agent_runs, issues, etc.) ---
# IMPORTANT: for local dev this MUST be your dedicated DEV Supabase project,
# NOT the PROD project. (Pointing dev at PROD will hard-fail at startup.)
# This is the real dev/prod data boundary — a separate Supabase PROJECT.
# (DB_SCHEMA below is NOT the dev/prod boundary; see its note.)
AGENTIC_VOP_SUPABASE_URL=https://YOUR-DEV-PROJECT.supabase.co
# service_role key from Supabase Dashboard -> Settings -> API -> "service_role secret"
# (the LONGER secret one — bypasses RLS). Keep this OUT of git.
AGENTIC_VOP_SUPABASE_SERVICE_KEY=eyJ...

# --- OpenAI for agent LLM calls ---
OPENAI_API_KEY=sk-...

# --- Tenable / Nessus (required to use the live tenable connector) ---
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=

# --- NVD API key (OPTIONAL — without it, NVD lookups are slower due to rate limits.
#     Get a free key at https://nvd.nist.gov/developers/request-an-api-key) ---
NVD_API_KEY=

# --- Intelligence Layer (DynamoDB-backed local CVE lookup) ---
# Set INTELLIGENCE_ENABLED=true to use local DynamoDB instead of direct NVD API calls.
# Table must be provisioned and backfilled before enabling.
INTELLIGENCE_ENABLED=
INTELLIGENCE_TABLE_NAME=
INTELLIGENCE_AWS_REGION=
MAX_SYNC_CACHE_MISSES=

# --- Parallel LLM worker count (OPTIONAL, default 10) ---
# Sub-Agent 1 and Sub-Agent 2 use a thread pool of this size when calling the LLM.
# Higher = faster runs, but watch your provider's rate limits.
# LLM_PARALLEL_WORKERS=10

# --- Secrets encryption (REQUIRED for production) ---
# 32-byte AES-256-GCM key, base64-encoded. Encrypts sensitive scanner metadata
# (auth headers, POST bodies, credentials) at rest in connection_registry.
# Generate with:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
SECRETS_ENCRYPTION_KEY=

# Which secrets backend to use. Only "local" (AES-256-GCM) is supported today.
# Future options: "aws_secrets_manager", "hashicorp_vault"
# SECRETS_BACKEND=local

# Comma-separated metadata keys treated as sensitive. Extend if you add custom
# credential fields to scanner metadata.
# SENSITIVE_METADATA_FIELDS=headers,body,credentials

# Block saving auth headers against non-HTTPS endpoints. Disable for local dev only.
# ENFORCE_HTTPS_ENDPOINTS=true

# --- Schema isolation (optional, intra-project) ---
# Postgres schema that the API targets. NOTE: this is NOT the dev/prod data
# boundary — the boundary is the Supabase PROJECT selected by APP_ENV +
# AGENTIC_VOP_SUPABASE_URL above. DB_SCHEMA only switches schemas WITHIN
# whichever project you're already connected to. Leave unset ("public") unless
# you specifically want per-schema separation inside one project.
# The demo pipeline (supabase_admin_demo) is unaffected by this setting.
# DB_SCHEMA=dev
